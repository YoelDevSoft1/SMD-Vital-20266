# ============================================
# SMD-Vital-2026 — Root .gitignore
# ============================================

# ----- Node / Build outputs -----
node_modules/
dist/
.output/
.cache/
.turbo/
.tsbuildinfo
*.tsbuildinfo
.npm/
.eslintcache
.stylelintcache
.parcel-cache/

# ----- Astro (frontend marketing) -----
.astro/

# ----- Logs -----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.pid
*.seed
*.pid.lock

# ----- Environment files -----
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# ----- Runtime data (do NOT track) -----
uploads/
tmp/
temp/

# ----- Coverage / Test artifacts -----
coverage/
.nyc_output/
junit.xml
test-results/
playwright-report/
.playwright-mcp/

# ----- OS files -----
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ----- Editors / IDE -----
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
*.swp
*.swo
*~
.project
.classpath
.settings/

# ----- Claude / Mavis working memory -----
.claude/
.mavis/

# ----- Docker artefacts -----
docker-compose.override.yml
.env.docker

# ----- Misc noise -----
.sass-cache/
*.gz
*.tgz

# ============================================
# Per-subproject .gitignore (kept explicit)
# See smd-vital-backend/.gitignore
# See admin-panel-frontend/.gitignore
