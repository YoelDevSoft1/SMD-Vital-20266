# Base de datos
DATABASE_URL="postgresql://username:password@localhost:5432/smd_vital"

# JWT — IMPORTANTE: JWT_SECRET y JWT_REFRESH_SECRET DEBEN ser distintos.
# Generate con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="tu_jwt_secret_muy_seguro_aqui"
JWT_REFRESH_SECRET="tu_jwt_refresh_secret_distinto_al_anterior"
JWT_EXPIRES_IN="7d"

# Redis
# Local (Docker Compose): redis://:smd_vital_redis_password@redis:6379
# Render / Production (Redis Labs Cloud): redis://default:<PASSWORD>@redis-XXXXX.c10.us-east-1-4.ec2.cloud.redislabs.com:XXXXX
REDIS_URL="redis://localhost:6379"

# Email (Opcional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="tu_email@gmail.com"
SMTP_PASS="tu_password_de_aplicacion"
# RESEND_API_KEY="re_..."
# RESEND_FROM_EMAIL="no-reply@tu-dominio.com"

# Cloudinary (Opcional)
